            },
            "url": {
              "raw": "{{baseUrl}}/partage",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "partage"
              ]
            },
            "description": "Partage une carte de l'utilisateur connecté (idCarte) avec un autre compte (idInvite). Le partage est un lien, pas une copie : les modifications et la suppression de la carte par le propriétaire sont visibles par l'invité."
          },
